<!-- A key on the keyboard, for shortcut hints ("E Done"). Decorative: the hint text carries the meaning. -->
<UserControl
    x:Class="DesktopBuddy.App.Ui.Components.Keycap"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <Border
        MinWidth="20"
        Padding="5,0,5,1"
        Background="{ThemeResource DbSurfaceSunkenBrush}"
        BorderBrush="{ThemeResource DbStrokeStrongBrush}"
        BorderThickness="1,1,1,2"
        CornerRadius="4">
        <TextBlock
            x:Name="KeyText"
            HorizontalAlignment="Center"
            FontSize="11"
            FontWeight="SemiBold"
            Foreground="{ThemeResource DbTextSecondaryBrush}" />
    </Border>
</UserControl>
