<!--
  One line of status with an optional fix ("IE Hub: Google Chat isn't working · Fix").
  Never colour-only: each severity has its own glyph, and the title says what's wrong in words.
  Used on the Board (one line at the top) and on Settings Home ("Needs attention").
-->
<UserControl
    x:Class="DesktopBuddy.App.Ui.Components.StatusLine"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <Grid x:Name="Root" ColumnSpacing="12" Padding="12,8,8,8" CornerRadius="{StaticResource DbRadiusRow}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <FontIcon x:Name="Icon" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="15" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock x:Name="TitleText" Style="{StaticResource DbBodyStyle}" TextWrapping="Wrap" />
            <TextBlock x:Name="DetailText" Style="{StaticResource DbCaptionStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
        <Button
            x:Name="ActionButton"
            Grid.Column="2"
            VerticalAlignment="Center"
            Style="{StaticResource DbSecondaryButtonStyle}"
            Visibility="Collapsed"
            Click="OnAction" />
    </Grid>
</UserControl>
