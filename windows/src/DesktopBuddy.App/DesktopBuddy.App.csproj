<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows app: WinUI 3 (Windows App SDK), unpackaged and self-contained,
       so it runs from a folder with nothing else to install. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>DesktopBuddy.App</RootNamespace>
    <AssemblyName>DesktopBuddy</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Without this, `dotnet publish` of an unpackaged app leaves out DesktopBuddy.pri and the
         compiled XAML (.xbf), and the published app crashes when it opens its first window. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Our own Main (Program.cs) keeps one copy running and handles snapshot mode. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
    <!-- Owner-approved exception to "no third-party libraries": Microsoft's Community Toolkit
         settings rows (SettingsCard / SettingsExpander), as Microsoft's winui-design skill recommends. -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DesktopBuddy.Core\DesktopBuddy.Core.csproj" />
    <ProjectReference Include="..\DesktopBuddy.Presentation\DesktopBuddy.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- A team.json in windows/ is built into the app (git-ignored, never committed). -->
    <Content Include="..\..\team.json" Link="team.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\team.json')" />
  </ItemGroup>
</Project>
