<!--
  Desktop Buddy design tokens — direction A, "Lily pad" (windows/DESIGN.md).
  Colours come from the Dynamatix mark: ink brown, lily teal, coral. Named by PURPOSE, never by hue.
  Every view uses these through {ThemeResource Db…Brush}; no colour literals in views.

  Contrast (WCAG 2, calculated against the base surface; all text pairs pass 4.5:1):
    Light: TextPrimary 17.1, TextSecondary 6.7, TextTertiary 4.7, Accent 4.9, Caution 4.9,
           Critical 6.3, Positive 4.8, TextOnWaiting on Waiting 4.8, TextOnAccent on accent fill 5.7.
    Dark:  TextPrimary 14.9, TextSecondary 7.7, TextTertiary 4.7, Accent 7.8, Caution 8.1,
           Critical 6.0, TextOnWaiting on Waiting 7.3, TextOnAccent on accent fill 8.2.
  High Contrast: only SystemColor* brushes (Microsoft winui-design rule).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Surfaces: warm paper, never pure white or black. -->
            <SolidColorBrush x:Key="DbSurfaceBaseBrush" Color="#FAFAF8" />
            <SolidColorBrush x:Key="DbSurfaceRaisedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DbSurfaceSunkenBrush" Color="#F2F0EB" />
            <SolidColorBrush x:Key="DbSurfaceInverseBrush" Color="#1A1714" />
            <SolidColorBrush x:Key="DbSurfaceSelectedBrush" Color="#137A82" Opacity="0.09" />
            <SolidColorBrush x:Key="DbSurfaceHoverBrush" Color="#1A1714" Opacity="0.045" />
            <!-- Text: ink-tinted, not grey. -->
            <SolidColorBrush x:Key="DbTextPrimaryBrush" Color="#1A1714" />
            <SolidColorBrush x:Key="DbTextSecondaryBrush" Color="#5E5852" />
            <SolidColorBrush x:Key="DbTextTertiaryBrush" Color="#766F67" />
            <SolidColorBrush x:Key="DbTextOnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DbTextOnInverseBrush" Color="#FAF7F2" />
            <SolidColorBrush x:Key="DbTextOnInverseSecondaryBrush" Color="#B9B0A6" />
            <!-- Signals -->
            <SolidColorBrush x:Key="DbAccentBrush" Color="#137A82" />
            <SolidColorBrush x:Key="DbWaitingBrush" Color="#C24E2C" />
            <SolidColorBrush x:Key="DbTextOnWaitingBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DbUrgentBrush" Color="#137A82" />
            <SolidColorBrush x:Key="DbPositiveBrush" Color="#2E7D5B" />
            <SolidColorBrush x:Key="DbCautionBrush" Color="#9A6214" />
            <SolidColorBrush x:Key="DbCriticalBrush" Color="#B3261E" />
            <SolidColorBrush x:Key="DbCautionSubtleBrush" Color="#B8741A" Opacity="0.12" />
            <SolidColorBrush x:Key="DbCriticalSubtleBrush" Color="#B3261E" Opacity="0.10" />
            <!-- Lines -->
            <SolidColorBrush x:Key="DbStrokeSubtleBrush" Color="#1A1714" Opacity="0.09" />
            <SolidColorBrush x:Key="DbStrokeStrongBrush" Color="#1A1714" Opacity="0.18" />
            <SolidColorBrush x:Key="DbStrokeOnInverseBrush" Color="#FFFFFF" Opacity="0.12" />
            <!-- The pad behind a client logo. -->
            <SolidColorBrush x:Key="DbPadBrush" Color="#FFFFFF" />
            <x:Double x:Key="DbPadRingOpacity">0.45</x:Double>
            <!-- Service glyphs (mail, chat, meeting, task, reminder): >= 3.8:1 on base and selected rows. -->
            <SolidColorBrush x:Key="DbSourceMailBrush" Color="#0A6ED1" />
            <SolidColorBrush x:Key="DbSourceChatBrush" Color="#1E8A3E" />
            <SolidColorBrush x:Key="DbSourceMeetingBrush" Color="#5856D6" />
            <SolidColorBrush x:Key="DbSourceTaskBrush" Color="#A86400" />
            <SolidColorBrush x:Key="DbSourceReminderBrush" Color="#137A82" />
            <!-- Soft shadow colour for elevated panels. -->
            <Color x:Key="DbShadowColor">#402A1A10</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="DbSurfaceBaseBrush" Color="#1E1C1A" />
            <SolidColorBrush x:Key="DbSurfaceRaisedBrush" Color="#262421" />
            <SolidColorBrush x:Key="DbSurfaceSunkenBrush" Color="#171614" />
            <SolidColorBrush x:Key="DbSurfaceInverseBrush" Color="#F4EFE8" />
            <SolidColorBrush x:Key="DbSurfaceSelectedBrush" Color="#4FC0C4" Opacity="0.16" />
            <SolidColorBrush x:Key="DbSurfaceHoverBrush" Color="#FFF6EA" Opacity="0.06" />
            <SolidColorBrush x:Key="DbTextPrimaryBrush" Color="#F4EFE8" />
            <SolidColorBrush x:Key="DbTextSecondaryBrush" Color="#B5ADA3" />
            <SolidColorBrush x:Key="DbTextTertiaryBrush" Color="#8E867C" />
            <SolidColorBrush x:Key="DbTextOnAccentBrush" Color="#0E1A1B" />
            <SolidColorBrush x:Key="DbTextOnInverseBrush" Color="#1A1714" />
            <SolidColorBrush x:Key="DbTextOnInverseSecondaryBrush" Color="#6E655C" />
            <SolidColorBrush x:Key="DbAccentBrush" Color="#4FC0C4" />
            <SolidColorBrush x:Key="DbWaitingBrush" Color="#F08A6C" />
            <SolidColorBrush x:Key="DbTextOnWaitingBrush" Color="#1A1714" />
            <SolidColorBrush x:Key="DbUrgentBrush" Color="#4FC0C4" />
            <SolidColorBrush x:Key="DbPositiveBrush" Color="#5CC59B" />
            <SolidColorBrush x:Key="DbCautionBrush" Color="#E5A84B" />
            <SolidColorBrush x:Key="DbCriticalBrush" Color="#F2726A" />
            <SolidColorBrush x:Key="DbCautionSubtleBrush" Color="#E5A84B" Opacity="0.14" />
            <SolidColorBrush x:Key="DbCriticalSubtleBrush" Color="#F2726A" Opacity="0.14" />
            <SolidColorBrush x:Key="DbStrokeSubtleBrush" Color="#FFF6EA" Opacity="0.09" />
            <SolidColorBrush x:Key="DbStrokeStrongBrush" Color="#FFF6EA" Opacity="0.18" />
            <SolidColorBrush x:Key="DbStrokeOnInverseBrush" Color="#1A1714" Opacity="0.12" />
            <SolidColorBrush x:Key="DbPadBrush" Color="#FFFFFF" />
            <x:Double x:Key="DbPadRingOpacity">0.6</x:Double>
            <SolidColorBrush x:Key="DbSourceMailBrush" Color="#5AA9FF" />
            <SolidColorBrush x:Key="DbSourceChatBrush" Color="#4FD07E" />
            <SolidColorBrush x:Key="DbSourceMeetingBrush" Color="#9A98FF" />
            <SolidColorBrush x:Key="DbSourceTaskBrush" Color="#FFB347" />
            <SolidColorBrush x:Key="DbSourceReminderBrush" Color="#4FC0C4" />
            <Color x:Key="DbShadowColor">#66000000</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="DbSurfaceBaseBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="DbSurfaceRaisedBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="DbSurfaceSunkenBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="DbSurfaceInverseBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="DbSurfaceSelectedBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="DbSurfaceHoverBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="DbTextPrimaryBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="DbTextSecondaryBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="DbTextTertiaryBrush" ResourceKey="SystemColorGrayTextColorBrush" />
            <StaticResource x:Key="DbTextOnAccentBrush" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="DbTextOnInverseBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="DbTextOnInverseSecondaryBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="DbAccentBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="DbWaitingBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="DbTextOnWaitingBrush" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="DbUrgentBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="DbPositiveBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="DbCautionBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="DbCriticalBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="DbCautionSubtleBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="DbCriticalSubtleBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="DbStrokeSubtleBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="DbStrokeStrongBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="DbStrokeOnInverseBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="DbPadBrush" ResourceKey="SystemColorWindowColorBrush" />
            <x:Double x:Key="DbPadRingOpacity">1</x:Double>
            <StaticResource x:Key="DbSourceMailBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="DbSourceChatBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="DbSourceMeetingBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="DbSourceTaskBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="DbSourceReminderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <Color x:Key="DbShadowColor">#00000000</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- The app's accent is lily teal, so built-in controls (switches, buttons, focus) match.
         WinUI uses SystemAccentColorDark1 for fills in Light and SystemAccentColorLight2 in Dark. -->
    <Color x:Key="SystemAccentColor">#137A82</Color>
    <Color x:Key="SystemAccentColorLight1">#2F959C</Color>
    <Color x:Key="SystemAccentColorLight2">#4FC0C4</Color>
    <Color x:Key="SystemAccentColorLight3">#86D7D9</Color>
    <Color x:Key="SystemAccentColorDark1">#11717A</Color>
    <Color x:Key="SystemAccentColorDark2">#0C5A61</Color>
    <Color x:Key="SystemAccentColorDark3">#08454A</Color>

    <!-- Radius: one per nesting level, concentric (outer = inner + padding). -->
    <CornerRadius x:Key="DbRadiusWindow">14</CornerRadius>
    <CornerRadius x:Key="DbRadiusPanel">14</CornerRadius>
    <CornerRadius x:Key="DbRadiusCard">10</CornerRadius>
    <CornerRadius x:Key="DbRadiusRow">8</CornerRadius>
    <CornerRadius x:Key="DbRadiusControl">6</CornerRadius>
    <CornerRadius x:Key="DbRadiusPill">16</CornerRadius>

    <!-- Space: 4 px grid. -->
    <x:Double x:Key="DbSpace1">4</x:Double>
    <x:Double x:Key="DbSpace2">8</x:Double>
    <x:Double x:Key="DbSpace3">12</x:Double>
    <x:Double x:Key="DbSpace4">16</x:Double>
    <x:Double x:Key="DbSpace6">24</x:Double>
    <x:Double x:Key="DbSpace8">32</x:Double>
    <x:Double x:Key="DbSpace12">48</x:Double>

    <!-- Type: Segoe UI Variable (the system font). Display axis for titles and the Peek sender. -->
    <FontFamily x:Key="DbDisplayFont">Segoe UI Variable Display</FontFamily>
    <FontFamily x:Key="DbTextFont">Segoe UI Variable Text</FontFamily>
    <FontFamily x:Key="DbSmallFont">Segoe UI Variable Small</FontFamily>

    <!-- Motion (milliseconds). Only opacity and scale move; see Ui/Motion.cs. -->
    <x:Double x:Key="DbMotionFast">83</x:Double>
    <x:Double x:Key="DbMotionNormal">167</x:Double>
    <x:Double x:Key="DbMotionSlow">250</x:Double>
</ResourceDictionary>
