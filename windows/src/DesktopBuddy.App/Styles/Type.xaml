<!--
  Desktop Buddy type and control styles (Lily pad). Built on the Fluent type ramp, so text
  scaling and High Contrast keep working. Use these keys in views; never set raw FontSize.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Page titles ("Home", "Accounts"): Display axis, 28. -->
    <Style x:Key="DbPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource DbDisplayFont}" />
        <Setter Property="Foreground" Value="{ThemeResource DbTextPrimaryBrush}" />
    </Style>

    <!-- Panel titles ("Waiting"), the Peek sender: Display axis, 20. -->
    <Style x:Key="DbPanelTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource DbDisplayFont}" />
        <Setter Property="Foreground" Value="{ThemeResource DbTextPrimaryBrush}" />
    </Style>

    <!-- Group headings inside a page ("Needs attention"). -->
    <Style x:Key="DbSectionStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource DbTextPrimaryBrush}" />
        <Setter Property="Margin" Value="2,28,0,10" />
    </Style>

    <!-- A row's main line (sender, setting name). -->
    <Style x:Key="DbRowTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource DbTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="DbBodyStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource DbTextPrimaryBrush}" />
    </Style>

    <!-- A row's second line (subject, description). -->
    <Style x:Key="DbSecondaryStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource DbTextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Meta text (times, counts, "Gatehouse · Gmail"). -->
    <Style x:Key="DbCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource DbTextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- The big number on Home. -->
    <Style x:Key="DbFigureStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleLargeTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource DbDisplayFont}" />
        <Setter Property="Foreground" Value="{ThemeResource DbWaitingBrush}" />
    </Style>

    <!-- Primary action: a lily-teal pill ("Open", "Open Board"). One per surface. -->
    <Style x:Key="DbPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource DbRadiusPill}" />
        <Setter Property="Padding" Value="14,5,14,6" />
    </Style>

    <!-- Secondary action: an outlined pill ("Done", "Later"). -->
    <Style x:Key="DbSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource DbRadiusPill}" />
        <Setter Property="Padding" Value="14,5,14,6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource DbStrokeStrongBrush}" />
    </Style>

    <!-- Quiet text action ("Clear all"). -->
    <Style x:Key="DbQuietButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource DbRadiusControl}" />
        <Setter Property="Padding" Value="8,4,8,5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource DbTextSecondaryBrush}" />
    </Style>

    <!-- Icon-only action (snooze, done, settings). Always give it AutomationProperties.Name. -->
    <Style x:Key="DbIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DbQuietButtonStyle}">
        <Setter Property="Padding" Value="7" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
    </Style>

    <!-- A grouped surface (Home hero, a setting group). Flat: no card inside a card. -->
    <Style x:Key="DbCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DbSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DbStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource DbRadiusCard}" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <!-- The Board, the Rail and the Peek's outer shell. -->
    <Style x:Key="DbPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DbSurfaceBaseBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DbStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource DbRadiusPanel}" />
    </Style>
</ResourceDictionary>
