<!--
  Settings window resources (Lily pad, windows/DESIGN.md §4).
  1. Community Toolkit SettingsCard / SettingsExpander retheme: their lightweight-styling keys point at our
     tokens, so every row is paper-raised with a hairline edge and nothing is a grey box.
  2. NavigationView: sunken sidebar, quiet selection.
  3. A few small styles the code-built pages share (icons, chips).
  Loaded once by Sk.EnsureResources(); no colour literals here, only tokens.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="SettingsCardBackground" ResourceKey="DbSurfaceRaisedBrush" />
            <StaticResource x:Key="SettingsCardBackgroundPointerOver" ResourceKey="DbSurfaceHoverBrush" />
            <StaticResource x:Key="SettingsCardBackgroundPressed" ResourceKey="DbSurfaceSelectedBrush" />
            <StaticResource x:Key="SettingsCardBackgroundDisabled" ResourceKey="DbSurfaceRaisedBrush" />
            <StaticResource x:Key="SettingsCardBorderBrush" ResourceKey="DbStrokeSubtleBrush" />
            <StaticResource x:Key="SettingsCardBorderBrushPointerOver" ResourceKey="DbStrokeSubtleBrush" />
            <StaticResource x:Key="SettingsCardBorderBrushPressed" ResourceKey="DbStrokeSubtleBrush" />
            <StaticResource x:Key="SettingsCardBorderBrushDisabled" ResourceKey="DbStrokeSubtleBrush" />
            <StaticResource x:Key="SettingsCardForeground" ResourceKey="DbTextPrimaryBrush" />
            <StaticResource x:Key="SettingsCardForegroundPointerOver" ResourceKey="DbTextPrimaryBrush" />
            <StaticResource x:Key="SettingsCardForegroundPressed" ResourceKey="DbTextPrimaryBrush" />
            <StaticResource x:Key="SettingsCardForegroundDisabled" ResourceKey="DbTextTertiaryBrush" />
            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="DbSurfaceSunkenBrush" />
            <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="DbSurfaceSunkenBrush" />
            <StaticResource x:Key="NavigationViewTopPaneBackground" ResourceKey="DbSurfaceSunkenBrush" />
            <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="DbSurfaceBaseBrush" />
            <StaticResource x:Key="NavigationViewItemForeground" ResourceKey="DbTextPrimaryBrush" />
            <StaticResource x:Key="NavigationViewItemForegroundPointerOver" ResourceKey="DbTextPrimaryBrush" />
            <StaticResource x:Key="NavigationViewItemForegroundPressed" ResourceKey="DbTextPrimaryBrush" />
            <StaticResource x:Key="NavigationViewItemForegroundSelected" ResourceKey="DbTextPrimaryBrush" />
            <StaticResource x:Key="NavigationViewItemForegroundSelectedPointerOver" ResourceKey="DbTextPrimaryBrush" />
            <StaticResource x:Key="NavigationViewItemForegroundSelectedPressed" ResourceKey="DbTextPrimaryBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundPointerOver" ResourceKey="DbSurfaceHoverBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundPressed" ResourceKey="DbSurfaceHoverBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="DbSurfaceSelectedBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="DbSurfaceSelectedBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedPressed" ResourceKey="DbSurfaceSelectedBrush" />
            <StaticResource x:Key="NavigationViewSelectionIndicatorForeground" ResourceKey="DbAccentBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <StaticResource x:Key="SettingsCardBackground" ResourceKey="DbSurfaceRaisedBrush" />
            <StaticResource x:Key="SettingsCardBackgroundPointerOver" ResourceKey="DbSurfaceHoverBrush" />
            <StaticResource x:Key="SettingsCardBackgroundPressed" ResourceKey="DbSurfaceSelectedBrush" />
            <StaticResource x:Key="SettingsCardBackgroundDisabled" ResourceKey="DbSurfaceRaisedBrush" />
            <StaticResource x:Key="SettingsCardBorderBrush" ResourceKey="DbStrokeSubtleBrush" />
            <StaticResource x:Key="SettingsCardBorderBrushPointerOver" ResourceKey="DbStrokeSubtleBrush" />
            <StaticResource x:Key="SettingsCardBorderBrushPressed" ResourceKey="DbStrokeSubtleBrush" />
            <StaticResource x:Key="SettingsCardBorderBrushDisabled" ResourceKey="DbStrokeSubtleBrush" />
            <StaticResource x:Key="SettingsCardForeground" ResourceKey="DbTextPrimaryBrush" />
            <StaticResource x:Key="SettingsCardForegroundPointerOver" ResourceKey="DbTextPrimaryBrush" />
            <StaticResource x:Key="SettingsCardForegroundPressed" ResourceKey="DbTextPrimaryBrush" />
            <StaticResource x:Key="SettingsCardForegroundDisabled" ResourceKey="DbTextTertiaryBrush" />
            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="DbSurfaceSunkenBrush" />
            <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="DbSurfaceSunkenBrush" />
            <StaticResource x:Key="NavigationViewTopPaneBackground" ResourceKey="DbSurfaceSunkenBrush" />
            <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="DbSurfaceBaseBrush" />
            <StaticResource x:Key="NavigationViewItemForeground" ResourceKey="DbTextPrimaryBrush" />
            <StaticResource x:Key="NavigationViewItemForegroundPointerOver" ResourceKey="DbTextPrimaryBrush" />
            <StaticResource x:Key="NavigationViewItemForegroundPressed" ResourceKey="DbTextPrimaryBrush" />
            <StaticResource x:Key="NavigationViewItemForegroundSelected" ResourceKey="DbTextPrimaryBrush" />
            <StaticResource x:Key="NavigationViewItemForegroundSelectedPointerOver" ResourceKey="DbTextPrimaryBrush" />
            <StaticResource x:Key="NavigationViewItemForegroundSelectedPressed" ResourceKey="DbTextPrimaryBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundPointerOver" ResourceKey="DbSurfaceHoverBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundPressed" ResourceKey="DbSurfaceHoverBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="DbSurfaceSelectedBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="DbSurfaceSelectedBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedPressed" ResourceKey="DbSurfaceSelectedBrush" />
            <StaticResource x:Key="NavigationViewSelectionIndicatorForeground" ResourceKey="DbAccentBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="SettingsCardBackground" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="SettingsCardBackgroundPointerOver" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="SettingsCardBackgroundPressed" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="SettingsCardBackgroundDisabled" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="SettingsCardBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="SettingsCardBorderBrushPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="SettingsCardBorderBrushPressed" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="SettingsCardBorderBrushDisabled" ResourceKey="SystemColorGrayTextColorBrush" />
            <StaticResource x:Key="SettingsCardForeground" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="SettingsCardForegroundPointerOver" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="SettingsCardForegroundPressed" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="SettingsCardForegroundDisabled" ResourceKey="SystemColorGrayTextColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- SettingsCard sizing. Rows are 16 wide on the sides and never shorter than a touch target. -->
    <Thickness x:Key="SettingsCardPadding">16,12,16,12</Thickness>
    <x:Double x:Key="SettingsCardMinHeight">56</x:Double>
    <x:Double x:Key="SettingsCardWrapThreshold">520</x:Double>
    <x:Double x:Key="SettingsCardWrapNoIconThreshold">400</x:Double>
    <x:Double x:Key="SettingsCardDescriptionFontSize">12</x:Double>
    <!-- The sidebar has no outline on the content edge. -->
    <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
    <Thickness x:Key="NavigationViewContentMargin">0</Thickness>

    <!-- Icons. Segoe Fluent Icons, in a token colour; a status glyph always has words beside it. -->
    <Style x:Key="SkIconSecondary" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource DbTextSecondaryBrush}" />
    </Style>
    <Style x:Key="SkIconPrimary" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource DbTextPrimaryBrush}" />
    </Style>
    <Style x:Key="SkIconAccent" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource DbAccentBrush}" />
    </Style>
    <Style x:Key="SkIconPositive" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource DbPositiveBrush}" />
    </Style>
    <Style x:Key="SkIconCaution" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource DbCautionBrush}" />
    </Style>
    <Style x:Key="SkIconCritical" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource DbCriticalBrush}" />
    </Style>
    <Style x:Key="SkIconOnAccent" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource DbTextOnAccentBrush}" />
    </Style>

    <!-- Service glyphs (mail, chat, meeting, task, reminder) in their theme tokens. -->
    <Style x:Key="SkIconSourceMail" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource DbSourceMailBrush}" />
    </Style>
    <Style x:Key="SkIconSourceChat" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource DbSourceChatBrush}" />
    </Style>
    <Style x:Key="SkIconSourceMeeting" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource DbSourceMeetingBrush}" />
    </Style>
    <Style x:Key="SkIconSourceTask" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource DbSourceTaskBrush}" />
    </Style>
    <Style x:Key="SkIconSourceReminder" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource DbSourceReminderBrush}" />
    </Style>

    <!-- The count beside Accounts and Clients while something needs a fix: caution, never the accent (which reads as "new"). -->
    <Style x:Key="SkCautionBadge" TargetType="InfoBadge">
        <Setter Property="Background" Value="{ThemeResource DbCautionBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource DbTextOnAccentBrush}" />
    </Style>

    <!-- Status text in the three levels (always next to an icon). -->
    <Style x:Key="SkTextPositive" TargetType="TextBlock" BasedOn="{StaticResource DbCaptionStyle}">
        <Setter Property="Foreground" Value="{ThemeResource DbPositiveBrush}" />
    </Style>
    <Style x:Key="SkTextCaution" TargetType="TextBlock" BasedOn="{StaticResource DbCaptionStyle}">
        <Setter Property="Foreground" Value="{ThemeResource DbCautionBrush}" />
    </Style>
    <Style x:Key="SkTextCritical" TargetType="TextBlock" BasedOn="{StaticResource DbCaptionStyle}">
        <Setter Property="Foreground" Value="{ThemeResource DbCriticalBrush}" />
    </Style>

    <!-- A chip (a sender, keyword, label or chat): a quiet pill, not a box. -->
    <Style x:Key="SkChip" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DbSurfaceSunkenBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DbStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="13" />
    </Style>

    <!-- The mail-style field that holds chips and the place to type. -->
    <Style x:Key="SkTokenBox" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DbSurfaceBaseBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DbStrokeStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource DbRadiusControl}" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style x:Key="SkTokenBoxFocused" TargetType="Border" BasedOn="{StaticResource SkTokenBox}">
        <Setter Property="BorderBrush" Value="{ThemeResource DbAccentBrush}" />
        <Setter Property="BorderThickness" Value="1,1,1,2" />
    </Style>

    <!-- A hairline between groups. -->
    <Style x:Key="SkHairline" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DbStrokeSubtleBrush}" />
        <Setter Property="Height" Value="1" />
    </Style>

    <!-- A big option card (Sign in with Google): a whole-card button. -->
    <Style x:Key="SkCardButton" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Background" Value="{ThemeResource DbSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DbStrokeSubtleBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource DbRadiusCard}" />
    </Style>

    <!-- The window's chrome: the sidebar and its title strip are sunken; the page is paper with a rounded corner. -->
    <Style x:Key="SkTitleStrip" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DbSurfaceSunkenBrush}" />
    </Style>
    <Style x:Key="SkContentSurface" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DbSurfaceBaseBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DbStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1,1,0,0" />
        <Setter Property="CornerRadius" Value="12,0,0,0" />
    </Style>
    <Style x:Key="SkWindowRoot" TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource DbSurfaceSunkenBrush}" />
    </Style>

    <!-- The ring around the colour you picked. -->
    <Style x:Key="SkRing" TargetType="Ellipse">
        <Setter Property="Stroke" Value="{ThemeResource DbTextPrimaryBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
    </Style>

    <!-- The big number on Home when nothing is waiting: quiet, not coral. -->
    <Style x:Key="SkFigureQuiet" TargetType="TextBlock" BasedOn="{StaticResource DbFigureStyle}">
        <Setter Property="Foreground" Value="{ThemeResource DbTextTertiaryBrush}" />
    </Style>

    <!-- A tiny dot for the tour's page indicator (the page number is also read out). -->
    <Style x:Key="SkDotOn" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource DbAccentBrush}" />
    </Style>
    <Style x:Key="SkDotOff" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource DbStrokeStrongBrush}" />
    </Style>
</ResourceDictionary>
