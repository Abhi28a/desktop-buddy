<!--
  The name that shows beside a Rail token on hover or keyboard focus ("RiskHawk · 1 waiting").
  Its own small window, because the Rail window is only as wide as the pill and a normal tooltip
  would be cut off at its edge. Same ink-in-light, paper-in-dark card as the Peek.
-->
<UserControl
    x:Class="DesktopBuddy.App.Views.Rail.RailTip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <Border
        Background="{ThemeResource DbSurfaceInverseBrush}"
        BorderBrush="{ThemeResource DbStrokeOnInverseBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource DbRadiusRow}"
        MaxWidth="320"
        Padding="10,5,10,6">
        <TextBlock
            x:Name="Label"
            Style="{StaticResource DbCaptionStyle}"
            Foreground="{ThemeResource DbTextOnInverseBrush}"
            TextWrapping="NoWrap"
            AutomationProperties.AutomationId="RailTip" />
    </Border>
</UserControl>
